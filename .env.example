# Environment variables for the /api/submit form handler.
# Copy to `.env` for local `vercel dev`, and set the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# NEVER commit real values — .env is gitignored.

# Google Sheet IDs (from each spreadsheet URL: /spreadsheets/d/<ID>/edit)
SHEET_ID_BOCA27=1XFmSBvGSwta1oGW0nYXVgvGytoHBPBJorzoVDgwCtpw
SHEET_ID_BOCOMP27=1ILIvATdgzY6R_SfW6jnPKiYS2l-07SyHiTITRUhw9UI

# Service account that has Editor access to BOTH spreadsheets.
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxxx@yyyy.iam.gserviceaccount.com
# The private key from the service-account JSON ("private_key" field).
# Keep the literal \n sequences; the handler converts them to newlines.
# Wrap the whole value in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Google Workspace SMTP (app password for maria@businessofconnections.com)
SMTP_USER=maria@businessofconnections.com
SMTP_PASS=your-16-char-app-password
# Where notifications are delivered (defaults to SMTP_USER if omitted).
NOTIFY_TO=maria@businessofconnections.com
